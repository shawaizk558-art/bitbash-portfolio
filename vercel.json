{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.bitbash.dev"
        }
      ],
      "destination": "https://bitbash.dev/:path*",
      "permanent": true
    },
    {
      "source": "/Service-Details/:id",
      "destination": "/services",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/data/(.*\\.json)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(media|media-posters|avatars)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/sync-mongodb-projects",
      "schedule": "30 8 * * *"
    },
    {
      "path": "/api/cron/generate-screenshots",
      "schedule": "0 9 * * *"
    }
  ]
}

